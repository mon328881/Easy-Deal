; ============================================================
; 太极·夔牛 V8 Adaptive - 默认稳健参数集
; 适用: XAUUSD / EURUSD 主流外汇, M5 或 M15 周期回测
; 风格: 单笔风险 1%, 偏保守, 适合首次回测验证逻辑
; ============================================================

InpMagic=20260522
InpComment=KN_V8
InpEnableGrid=true
InpEnableBreakout=true
InpSlippagePoints=20

InpRiskPercent=1.0
InpFixedLotFallback=0.01
InpMaxLotPerTrade=1.0
InpMaxMarginUsedPct=50.0

InpDailyLossLimitPct=5.0
InpMaxDrawdownPct=15.0
InpCircuitCooldownMin=1440

InpRegimeTF=16385
InpADX_Period=14
InpADX_RangeMax=22.0
InpADX_TrendMin=23.0
InpATR_Period=14
InpATR_AvgLookback=20
InpATR_HighVolMult=1.8
InpRegimeMinHoldBars=2

InpGrid_SpacingATR=0.6
InpGrid_MaxLevels=6
InpGrid_LotMultiplier=1.3
InpGrid_SL_ATR_Mult=2.5
InpGrid_TP_ATR_Mult=1.0
InpGrid_BasketTP_USD=15.0
InpGrid_BasketSL_Pct=3.0
InpGrid_CooldownSec=30

InpBO_Lookback=20
InpBO_ATR_AccelMult=1.2
InpBO_MaxSameSide=2
InpBO_SL_ATR_Mult=2.0
InpBO_BE_TriggerATR=1.0
InpBO_TrailStartATR=1.8
InpBO_TrailDistATR=1.5
InpBO_TrailStepATR=0.3
InpBO_CooldownSec=120

InpMaxSpreadPoints=400.0
InpUseSessionFilter=false
InpSessionStartHour=8
InpSessionEndHour=22
