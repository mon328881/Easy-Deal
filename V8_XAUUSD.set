; ============================================================
; 太极·夔牛 V8 Adaptive - XAUUSD (黄金) 专属参数集
; 适用: XAUUSD / XAUUSDm / GOLD 等黄金品种, 5 位小数账户
; 优化点:
;   1. 点差上限按黄金实测放大 (5 位小数账户点差 200~400 point 是常态)
;   2. ATR 倍数距离按黄金 3~5 USD 的常规 ATR 调整
;   3. ADX 缓冲带收窄, 减少"中性"卡死时间
;   4. 整篮止盈金额按黄金 1 个 pip = $0.1/0.01 lot 重新校准
; ============================================================

InpMagic=20260522
InpComment=KN_V8X
InpEnableGrid=true
InpEnableBreakout=true
InpSlippagePoints=50

InpRiskPercent=1.0
InpFixedLotFallback=0.01
InpMaxLotPerTrade=1.0
InpMaxMarginUsedPct=50.0

InpDailyLossLimitPct=5.0
InpMaxDrawdownPct=15.0
InpCircuitCooldownMin=720

InpRegimeTF=16385
InpADX_Period=14
InpADX_RangeMax=22.0
InpADX_TrendMin=23.0
InpATR_Period=14
InpATR_AvgLookback=20
InpATR_HighVolMult=2.5
InpRegimeMinHoldBars=1

InpGrid_SpacingATR=0.5
InpGrid_MaxLevels=6
InpGrid_LotMultiplier=1.3
InpGrid_SL_ATR_Mult=2.5
InpGrid_TP_ATR_Mult=1.0
InpGrid_BasketTP_USD=30.0
InpGrid_BasketSL_Pct=3.0
InpGrid_CooldownSec=30

InpBO_Lookback=20
InpBO_ATR_AccelMult=1.05
InpBO_MaxSameSide=2
InpBO_SL_ATR_Mult=2.0
InpBO_BE_TriggerATR=1.0
InpBO_TrailStartATR=1.8
InpBO_TrailDistATR=1.5
InpBO_TrailStepATR=0.3
InpBO_CooldownSec=120

InpMaxSpreadPoints=500.0
InpUseSessionFilter=false
InpSessionStartHour=8
InpSessionEndHour=22

InpEnableDiagnostic=true
InpDiagnosticIntervalSec=30
InpShowControlPanel=true
